{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:engineering-graph:check-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "check_id", "command_id", "argv", "outcome", "exit_code", "timed_out", "stdout_sha256", "stderr_sha256", "repo_worktree_sha256", "started_at", "finished_at", "producer_actor", "producer_host_identity"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "check_receipt"},
    "run_id": {"$ref": "#/$defs/id"},
    "check_id": {"$ref": "#/$defs/id"},
    "command_id": {"$ref": "#/$defs/id"},
    "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "exit_code": {"type": "integer"},
    "timed_out": {"type": "boolean"},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "stderr_sha256": {"$ref": "#/$defs/digest"},
    "repo_worktree_sha256": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "producer_actor": {"type": "string", "minLength": 1},
    "producer_host_identity": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
