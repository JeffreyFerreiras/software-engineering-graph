{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-engineering-graph/fanout-assessment.schema.json",
  "title": "Fan-out resource assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "fanout_id", "members", "dependencies", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fanout_assessment"},
    "run_id": {"type": "string", "minLength": 1},
    "fanout_id": {"type": "string", "minLength": 1},
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "resources"],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["writable_paths", "mutable_state_refs", "exclusive_device_refs", "services"],
            "properties": {
              "writable_paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "scope"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "scope": {"enum": ["exact", "subtree"]}
                  }
                }
              },
              "mutable_state_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "exclusive_device_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "services": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref", "units", "capacity"],
                  "properties": {
                    "ref": {"type": "string", "minLength": 1},
                    "units": {"type": "integer", "minimum": 1},
                    "capacity": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before_branch_id", "after_branch_id", "reason"],
        "properties": {
          "before_branch_id": {"type": "string", "minLength": 1},
          "after_branch_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
