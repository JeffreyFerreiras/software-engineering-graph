{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:engineering-graph:task-brief:v2",
  "title": "Immutable engineering graph task brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "objective", "user_outcome", "request_mode", "minimum_route", "mandatory_impact_tags", "scope", "constraints", "acceptance_criteria", "risk_level", "authority", "policy_approval", "evidence_paths", "inspection_budget", "required_check_ids", "required_human_decisions"],
  "oneOf": [
    {"properties": {"schema_version": {"const": 1}}, "not": {"required": ["model_sizing"]}},
    {"required": ["model_sizing"], "properties": {"schema_version": {"const": 2}}}
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "task_id": {"$ref": "#/$defs/id"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "user_outcome": {"type": "string", "minLength": 1, "maxLength": 4096},
    "request_mode": {"enum": ["advisory", "design_only", "delivery"]},
    "minimum_route": {"enum": ["advisory", "design_only", "fast_path", "full_delivery"]},
    "mandatory_impact_tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "excluded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}}}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "authority": {"type": "object", "additionalProperties": false, "required": ["capabilities"], "properties": {"capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}}},
    "policy_approval": {"type": "object", "additionalProperties": false, "required": ["sha256", "authority_ref"], "properties": {"sha256": {"$ref": "#/$defs/digest"}, "authority_ref": {"type": "string", "pattern": "^authority:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}}},
    "evidence_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "inspection_budget": {"type": "object", "additionalProperties": false, "required": ["file_reads", "discovery_commands"], "properties": {"file_reads": {"type": "integer", "minimum": 0}, "discovery_commands": {"type": "integer", "minimum": 0}}},
    "required_check_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "required_human_decisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "reviewer_delegation": {"$ref": "#/$defs/reviewerDelegation"},
    "model_sizing": {"type": "object", "additionalProperties": false, "required": ["scope_extent", "uncertainty"], "properties": {"scope_extent": {"enum": ["bounded", "cross_file", "broadly_cross_cutting"]}, "uncertainty": {"enum": ["low", "medium", "high"]}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "object", "additionalProperties": false, "required": ["effect", "action", "target_ref"], "properties": {"effect": {"enum": ["filesystem_read", "filesystem_write", "command", "external_read", "external_write", "destructive", "publish", "deploy"]}, "action": {"$ref": "#/$defs/id"}, "target_ref": {"type": "string", "minLength": 1}}},
    "reviewerDelegationLimits": {"type": "object", "additionalProperties": false, "required": ["max_depth", "max_children_per_request", "max_children_per_run", "max_request_rounds", "max_weighted_dispatch_cost"], "properties": {"max_depth": {"type": "integer", "minimum": 0, "maximum": 1}, "max_children_per_request": {"type": "integer", "minimum": 0, "maximum": 3}, "max_children_per_run": {"type": "integer", "minimum": 0, "maximum": 6}, "max_request_rounds": {"type": "integer", "minimum": 0, "maximum": 2}, "max_weighted_dispatch_cost": {"type": "integer", "minimum": 0, "maximum": 15}}},
    "taskDelegationAssignment": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "allowed_reason_codes", "allowed_acceptance_ids", "allowed_evidence_kinds", "scope_refs", "max_instances"], "properties": {"assignment_id": {"$ref": "#/$defs/id"}, "allowed_reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allowed_acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "allowed_evidence_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "scope_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1200}}, "max_instances": {"type": "integer", "minimum": 1, "maximum": 3}}},
    "reviewerDelegation": {"type": "object", "additionalProperties": false, "required": ["limits", "assignments"], "properties": {"limits": {"$ref": "#/$defs/reviewerDelegationLimits"}, "assignments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskDelegationAssignment"}}}}
  }
}
