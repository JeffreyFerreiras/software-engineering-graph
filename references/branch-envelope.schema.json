{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:engineering-graph:branch-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "branch_id", "node_instance_id", "node_key", "role", "model", "reasoning_effort", "mandatory", "generation", "status", "inputs", "effect_capabilities", "output_contract", "stopping_condition", "artifact_ref", "evidence", "decision", "retry_count", "max_retries", "attempt_id", "claim_digest", "lease_expires_at", "failure_code", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "branch_id": {"type": "string", "pattern": "^g2-[0-9a-f]{24}$"},
    "node_instance_id": {"type": "string", "pattern": "^g2-[0-9a-f]{24}$"},
    "node_key": {"$ref": "#/$defs/id"},
    "role": {"$ref": "#/$defs/id"},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "reasoning_effort": {"type": "string", "minLength": 1, "maxLength": 32},
    "mandatory": {"type": "boolean"},
    "generation": {"type": "integer", "minimum": 0},
    "research_assignment": {"$ref": "#/$defs/researchAssignment"},
    "status": {"enum": ["pending", "ready", "running", "waiting_for_review_children", "succeeded", "failed", "timed_out", "skipped"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "effect_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "output_contract": {"$ref": "#/$defs/outputContract"},
    "stopping_condition": {"type": "object", "additionalProperties": false, "required": ["kind", "max_branch_attempts"], "properties": {"kind": {"const": "valid_result_returned"}, "max_branch_attempts": {"type": "integer", "minimum": 1}}},
    "artifact_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/contentRef"}]},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contentRef"}},
    "decision": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "max_retries": {"type": "integer", "minimum": 0},
    "attempt_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "claim_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "claim_token": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "lease_expires_at": {"type": ["string", "null"]},
    "failure_code": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "parent_branch_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "request_slot_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "assignment_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "ordinal": {"type": ["integer", "null"]},
    "depth": {"type": "integer", "minimum": 0, "maximum": 1},
    "review_assignment": {"type": "object", "additionalProperties": false, "required": ["review_lens", "prompt_template", "reason_code", "acceptance_ids", "evidence_ids", "evidence", "scope_refs"], "properties": {"review_lens": {"type": "string"}, "prompt_template": {"type": "string"}, "reason_code": {"$ref": "#/$defs/id"}, "acceptance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reviewEvidence"}}, "scope_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "review_continuation": {"type": "object", "additionalProperties": false, "required": ["review_request_slots", "child_members", "terminal_non_successes", "finding_sources"], "properties": {"review_request_slots": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}}, "child_members": {"type": "array", "items": {"type": "array", "minItems": 4, "maxItems": 4}}, "terminal_non_successes": {"type": "array", "items": {"type": "object"}}, "finding_sources": {"type": "array", "items": {"type": "array", "minItems": 6, "maxItems": 6}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewEvidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "sha256"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256", "size_bytes"], "properties": {"kind": {"$ref": "#/$defs/id"}, "ref": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}, "content": {"type": "object"}}},
    "contentRef": {"type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256"], "properties": {"kind": {"$ref": "#/$defs/id"}, "ref": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["effect", "action", "target_ref"], "properties": {"effect": {"type": "string"}, "action": {"$ref": "#/$defs/id"}, "target_ref": {"type": "string"}}},
    "outputContract": {"type": "object", "additionalProperties": false, "required": ["artifact_kind", "schema_version", "artifact_required"], "properties": {"artifact_kind": {"$ref": "#/$defs/id"}, "schema_version": {"const": 1}, "artifact_required": {"type": "boolean"}, "evidence_required": {"type": "boolean"}, "decision_forbidden": {"type": "boolean"}, "findings_forbidden": {"type": "boolean"}, "decision_values": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "artifact_required_for_decisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_required_for_decisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "researchAssignment": {"type": "object", "additionalProperties": false, "required": ["focus", "inspection_budget"], "properties": {"focus": {"enum": ["architecture", "validation"]}, "inspection_budget": {"type": "object", "additionalProperties": false, "required": ["file_reads", "discovery_commands"], "properties": {"file_reads": {"type": "integer", "minimum": 0}, "discovery_commands": {"type": "integer", "minimum": 0}}}}}
  }
}
